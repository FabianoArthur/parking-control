# Copy to .env (never commit .env). Used by docker-compose.yml and by the app.
POSTGRES_DB=parking
POSTGRES_USER=parking
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
APP_PORT=8080

# When running the app outside Docker (./mvnw spring-boot:run):
DB_URL=jdbc:postgresql://localhost:5432/parking
DB_USERNAME=parking
DB_PASSWORD=change-me
